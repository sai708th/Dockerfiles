# PHPバージョンとWPコアバージョンは独立して指定できる。
# 'task wpsetver WP=<WPコアバージョン> PHP=<PHPマイナーバージョン>' で自動更新される(手動編集も可)。
#
# 仕組み:
#   - WORDPRESS_TAG / PHP_VERSION: ベースイメージ(PHP)の選択。phpX.Y単位でのみ選択可。
#   - WP_VERSION: 指定するとビルド時にwp-cliでWPコアをこのバージョンに強制downgrade/upgradeする。
#   - WPCLI_VERSION: 古いPHPでは最新wp-cliが動かないため、互換バージョンに固定する。
#
# 例: task wpsetver WP=5.2.12 PHP=5.6 / task wpsetver PHP=7.4 / task wpsetver WP=6.4 / task wpsetver
# 指定可能なPHPバージョンは 'task wpversions FILTER=phpX.Y' で確認できる。
#
# 現在の設定: PHP5.6系イメージ(パッチは同梱の最新5.6.x) + WPコアを5.2.12に強制固定
WORDPRESS_TAG=php5.6-apache
PHP_VERSION=5.6
WP_VERSION=5.2.12
WPCLI_VERSION=2.6.0
